{
  "$schema": "https://raw.githubusercontent.com/nicorevin/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Voice Style Converter",
  "version": "0.1.0",
  "identifier": "com.aiirononeko.voice-style-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Style Converter",
        "visible": false,
        "width": 480,
        "height": 640
      },
      {
        "label": "overlay",
        "url": "/overlay.html",
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": false,
        "width": 120,
        "height": 120,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["prompts/*"]
  }
}
